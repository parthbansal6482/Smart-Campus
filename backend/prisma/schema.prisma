generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  FACULTY
  CAFETERIA_STAFF
  MEDICAL_STAFF
  AMBULANCE_RESPONDER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum EmergencyStatus {
  REPORTED
  ASSIGNED
  ON_THE_WAY
  ARRIVED
  HANDLED
  CANCELLED
}

enum EmergencyTag {
  FAINTED
  INJURY
  ALLERGIC_REACTION
  OTHER
}

enum MedicineCategory {
  PAIN_RELIEF
  FIRST_AID
  COLD_FEVER
  PRESCRIPTION_ONLY
  GENERAL
}

enum MedicineOrderStatus {
  PLACED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum ConsultationType {
  CHAT
  CALLBACK
  APPOINTMENT
}

enum ConsultationStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum OrderType {
  PICKUP
  DINE_IN
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  COLLECTED
  CANCELLED
}

enum MenuCategory {
  BREAKFAST
  LUNCH
  SNACKS
  BEVERAGES
  DESSERTS
  SPECIAL
}

// -------------------------------------------------------------
// USER & SHARED AUTH
// -------------------------------------------------------------
model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         Role          @default(STUDENT)
  phone        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  bookings          Booking[]
  emergencies       Emergency[]
  medicineOrders    MedicineOrder[]
  consultations     Consultation[]
  orders            Order[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// -------------------------------------------------------------
// MODULE 1: CLASSROOM MANAGEMENT (LOGIC PRESERVED)
// -------------------------------------------------------------
model Building {
  id          String      @id @default(uuid())
  name        String
  code        String      @unique
  latitude    Float
  longitude   Float
  floorCount  Int         @default(1) @map("floor_count")
  createdAt   DateTime    @default(now()) @map("created_at")

  rooms       Room[]
  emergencies Emergency[]

  @@map("buildings")
}

model Room {
  id           String      @id @default(uuid())
  buildingId   String      @map("building_id")
  roomNumber   String      @map("room_number")
  floor        Int         @default(1)
  capacity     Int         @default(30)
  hasAC        Boolean     @default(true) @map("has_ac")
  hasProjector Boolean     @default(true) @map("has_projector")
  isOccupied   Boolean     @default(false) @map("is_occupied")
  createdAt    DateTime    @default(now()) @map("created_at")

  building     Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@unique([buildingId, roomNumber])
  @@index([buildingId])
  @@index([isOccupied])
  @@map("rooms")
}

model Booking {
  id        String        @id @default(uuid())
  roomId    String        @map("room_id")
  userId    String        @map("user_id")
  startTime DateTime      @map("start_time")
  endTime   DateTime      @map("end_time")
  purpose   String?
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now()) @map("created_at")

  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime, endTime])
  @@index([userId])
  @@index([status])
  @@map("bookings")
}

// -------------------------------------------------------------
// MODULE 2: MEDICAL HELP (EXPANDED)
// -------------------------------------------------------------
model Emergency {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  latitude    Float
  longitude   Float
  buildingId  String?         @map("building_id")
  tag         EmergencyTag    @default(OTHER)
  description String?
  status      EmergencyStatus @default(REPORTED)
  responderId String?         @map("responder_id")
  reportedAt  DateTime        @default(now()) @map("reported_at")
  resolvedAt  DateTime?       @map("resolved_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  building    Building?       @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([reportedAt])
  @@map("emergencies")
}

model Medicine {
  id                   String           @id @default(uuid())
  name                 String
  category             MedicineCategory @default(GENERAL)
  price                Float
  description          String?
  stock                Int              @default(50)
  requiresPrescription Boolean          @default(false) @map("requires_prescription")
  imageUrl             String?          @map("image_url")
  createdAt            DateTime         @default(now()) @map("created_at")

  orderItems           MedicineOrderItem[]

  @@index([category])
  @@map("medicines")
}

model MedicineOrder {
  id                String              @id @default(uuid())
  userId            String              @map("user_id")
  totalAmount       Float               @map("total_amount")
  status            MedicineOrderStatus @default(PLACED)
  pickupOrDelivery  String              @default("PICKUP") @map("pickup_or_delivery")
  deliveryAddress   String?             @map("delivery_address")
  prescriptionUrl   String?             @map("prescription_url")
  createdAt         DateTime            @default(now()) @map("created_at")

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             MedicineOrderItem[]

  @@index([userId])
  @@index([status])
  @@map("medicine_orders")
}

model MedicineOrderItem {
  id              String        @id @default(uuid())
  medicineOrderId String        @map("medicine_order_id")
  medicineId      String        @map("medicine_id")
  quantity        Int           @default(1)
  unitPrice       Float         @map("unit_price")

  medicineOrder   MedicineOrder @relation(fields: [medicineOrderId], references: [id], onDelete: Cascade)
  medicine        Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@map("medicine_order_items")
}

model Consultation {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  type        ConsultationType   @default(CALLBACK)
  status      ConsultationStatus @default(REQUESTED)
  slotTime    DateTime?          @map("slot_time")
  note        String?
  assignedTo  String?            @map("assigned_to")
  createdAt   DateTime           @default(now()) @map("created_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("consultations")
}

// -------------------------------------------------------------
// MODULE 3: CAFETERIA FOOD ORDERING (EXPANDED)
// -------------------------------------------------------------
model MenuItem {
  id          String       @id @default(uuid())
  name        String
  description String?
  price       Float
  category    MenuCategory @default(SNACKS)
  isVeg       Boolean      @default(true) @map("is_veg")
  spiceLevel  Int          @default(0) @map("spice_level")
  rating      Float        @default(4.5)
  isAvailable Boolean      @default(true) @map("is_available")
  imageUrl    String?      @map("image_url")
  createdAt   DateTime     @default(now()) @map("created_at")

  orderItems  OrderItem[]

  @@index([category])
  @@index([isVeg])
  @@index([isAvailable])
  @@map("menu_items")
}

model Order {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  orderType   OrderType   @default(PICKUP) @map("order_type")
  tableNumber String?     @map("table_number")
  orderToken  String      @map("order_token")
  status      OrderStatus @default(PLACED)
  pickupTime  DateTime?   @map("pickup_time")
  totalAmount Float       @map("total_amount")
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  menuItemId String   @map("menu_item_id")
  quantity   Int      @default(1)
  unitPrice  Float    @map("unit_price")

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Offer {
  id             String   @id @default(uuid())
  title          String
  description    String?
  code           String   @unique
  discountPercent Float   @map("discount_percent")
  isBanner       Boolean  @default(true) @map("is_banner")
  imageUrl       String?  @map("image_url")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("offers")
}
