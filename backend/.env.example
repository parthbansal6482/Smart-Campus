# Server Configuration
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL)
# 1. DATABASE_URL: Transaction / Session Pooler URL (port 6543 or 5432)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"

# 2. DIRECT_URL: Direct Connection URL (port 5432, used by Prisma migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public"

# JWT Authentication
# JWT_SECRET is REQUIRED in production — the server refuses to start without
# it rather than falling back to an insecure default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-generate-a-real-secret"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="30d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS — comma-separated list of allowed origins. Required in production;
# in development an empty value allows any origin, for convenience with
# Expo's changing local ports.
CORS_ORIGINS=http://localhost:5173

# File uploads (prescriptions, etc.) — stored on local disk under this dir,
# served back at /uploads/<filename>. Swap for S3/Supabase Storage later
# without changing the upload API surface.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Outgoing email (password reset). If left unset, emails are logged to the
# console instead of sent — fine for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Campus <no-reply@smartcampus.edu>"

# How close (metres) an emergency's GPS point must be to a building's
# recorded coordinates before that building is auto-attached to the alert.
# The alert is always created immediately regardless of this — it only
# affects which building (if any) gets matched to it.
BUILDING_MATCH_RADIUS_METERS=300
